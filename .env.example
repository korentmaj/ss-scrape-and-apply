# SMTP / Gmail (required for mailer.js)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=16_char_app_password
MAIL_FROM=your_email@gmail.com
MAIL_DAILY_CAP=5
MAIL_DRY_RUN=true

# Optional target for mailer_example.js
MAIL_TEST_TO=

# Notion credentials (required for output_mode=notion or both)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Optional overrides
SCRAPER_OUTPUT_MODE=notion
SCRAPER_APPLY_ONLY=false
SCRAPER_EMAIL_AUTO_SEND=true
SCRAPER_EMAIL_SUBJECT=Prijava na študentsko delo
# SCRAPER_EMAIL_BODY supports \\n for line breaks if set here.
SCRAPER_EMAIL_BODY=
SCRAPER_EMAIL_ATTACHMENT_FILE=
SCRAPER_CHROME_USER_DATA_DIR=
SCRAPER_CHROME_PROFILE_DIRECTORY=Default
